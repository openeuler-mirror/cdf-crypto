# -*- rpm-spec -*-
Name:           cdf-crypto
Version:        @PROJECT_VERSION@
Release:        1
Summary:        Confidential Data defensive Framework
Summary(zh_CN): 敏感数据保护框架（CDF）
License:        MulanPSL-2.0
URL:            https://atomgit.com/openeuler/cdf-crypto.git
Source0:        %{name}-%{version}.tar.gz

%define cdf_cmake_bindir @CMAKE_INSTALL_BINDIR@
%define cdf_cmake_includedir @CMAKE_INSTALL_INCLUDEDIR@
%define cdf_cmake_libdir @CMAKE_INSTALL_LIBDIR@
%define cdf_cpack_stage @PROJECT_BINARY_DIR@/cpack-staging

%description
cdf-crypto(Confidential Data defensive Framework) provides cryptographic algorithms and key security functions.

%prep

%build

%install
mkdir -p %{buildroot}%{_includedir}/cdf
mkdir -p %{buildroot}%{_libdir}/cdf
mkdir -p %{buildroot}%{_bindir}/cdf/config
mkdir -p %{buildroot}%{_bindir}/cdf/bin

# Consume only the install tree prepared by CPack. This keeps direct cpack and
# the generated package target independent from an external install prefix.
if [ -d "%{cdf_cpack_stage}/%{cdf_cmake_bindir}" ]; then
    cp -a "%{cdf_cpack_stage}/%{cdf_cmake_bindir}/." %{buildroot}%{_bindir}/cdf/bin/
fi
if [ -d "%{cdf_cpack_stage}/config" ]; then
    cp -a "%{cdf_cpack_stage}/config/." %{buildroot}%{_bindir}/cdf/config/
fi
if [ -d "%{cdf_cpack_stage}/%{cdf_cmake_includedir}/cdf" ]; then
    cp -a "%{cdf_cpack_stage}/%{cdf_cmake_includedir}/cdf/." %{buildroot}%{_includedir}/cdf/
fi
if [ -d "%{cdf_cpack_stage}/%{cdf_cmake_libdir}" ]; then
    cp -a "%{cdf_cpack_stage}/%{cdf_cmake_libdir}/." %{buildroot}%{_libdir}/cdf/
fi

# RPM post-processing strips binaries in buildroot and requires owner-write.
# The final package permissions are reset by the manifest below.
find %{buildroot}%{_libdir}/cdf -type f -exec chmod u+w {} \;

# Generate the manifest from the selected modules' actual install tree.  The
# package owns only its private directory trees, never shared system parents.
# Doubled percent signs escape RPM macro expansion and produce file directives.
manifest=%{_builddir}/cdf-crypto.files
for owned_root in \
    %{buildroot}%{_bindir}/cdf \
    %{buildroot}%{_includedir}/cdf \
    %{buildroot}%{_libdir}/cdf; do
    find "${owned_root}" -type d -print
done | sed -e 's#^%{buildroot}##' \
           -e 's#^#%%dir %%attr(750,root,root) #' > "${manifest}"
find %{buildroot}%{_bindir}/cdf/config -type f -print | \
    sed -e 's#^%{buildroot}##' \
        -e 's#^#%%config(noreplace) %%attr(640,root,root) #' >> "${manifest}"
find %{buildroot}%{_bindir}/cdf/bin -type f -print | \
    sed -e 's#^%{buildroot}##' \
        -e 's#^#%%attr(750,root,root) #' >> "${manifest}"
find %{buildroot}%{_includedir}/cdf -type f -print | \
    sed -e 's#^%{buildroot}##' \
        -e 's#^#%%attr(440,root,root) #' >> "${manifest}"
find %{buildroot}%{_libdir}/cdf \( -type f -o -type l \) -print | \
    sed -e 's#^%{buildroot}##' \
        -e 's#^#%%attr(550,root,root) #' >> "${manifest}"

%clean
rm -rf %{buildroot}

%files -f %{_builddir}/cdf-crypto.files
%defattr(750,root,root,750)
