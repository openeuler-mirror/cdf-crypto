if(ENABLE_DOWNLOAD_DEPENDENCY)
  set(DOWNLOAD_ARGS
      GIT_REPOSITORY https://github.com/BLAKE3-team/BLAKE3.git
      GIT_TAG 1.8.5
      GIT_SHALLOW On)
else()
  set(DOWNLOAD_ARGS
      SOURCE_DIR ${CMAKE_DEPENDENCY_SRCDIR}/blake3
      DOWNLOAD_COMMAND "")
endif()

ExternalProject_Add(
  blake3
  ${DOWNLOAD_ARGS}
  PREFIX ${DEPENDENCY_INSTALL_PREFIX_NAME}
  SOURCE_SUBDIR c
  CMAKE_ARGS
    -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
    -DCMAKE_INSTALL_PREFIX=${CMAKE_DEPENDENCY_INSTALL_PREFIX}
    -DCMAKE_INSTALL_LIBDIR=${CMAKE_INSTALL_LIBDIR}
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    -DBUILD_SHARED_LIBS=OFF
    -DBUILD_TESTING=OFF
    -DBLAKE3_USE_TBB=OFF
    -DBLAKE3_FETCH_TBB=OFF
  BUILD_BYPRODUCTS
    "${CMAKE_DEPENDENCY_LIBDIR}/libblake3${CMAKE_STATIC_LIBRARY_SUFFIX}"
  EXCLUDE_FROM_ALL On
  LOG_DOWNLOAD On
  LOG_CONFIGURE On
  LOG_BUILD On
  LOG_INSTALL On)

import_static_lib_from(libblake3 blake3)
add_library(Dependency::blake3 ALIAS libblake3)
